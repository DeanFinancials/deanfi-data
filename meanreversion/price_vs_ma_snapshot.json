      "moderately_overbought": "Z-score 1 to 2",
      "normal_range": "Z-score -1 to 1",
      "moderately_oversold": "Z-score -2 to -1",
      "extremely_oversold": "Z-score < -2 (potential reversal up)",
      "insufficient_data": "Not enough data for calculation"
    },
    "trend_alignment": {
